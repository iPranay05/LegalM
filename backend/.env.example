APP_NAME=Legal Metrology Compliance API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=False

# Database
DATABASE_URL=postgresql://legalm:change-me@postgres:5432/legalm

# Auth (JWT)
SECRET_KEY=replace-with-a-random-local-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tesseract binary path
TESSERACT_CMD=

# Upload directory
UPLOAD_DIR=uploads

# Groq LLM API key
GROQ_API_KEY=

# Browser origins (comma-separated; never use * with credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
